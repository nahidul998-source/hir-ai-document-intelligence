# App Configuration
APP_NAME="HIR - Human Intelligent Review"
APP_ENV=development # development, testing, production
DEBUG=true

# Database Configuration (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=hir_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration (Cache/Session/Celery Backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration (Events / Tasks Broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# MinIO Configuration (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=miniouser
MINIO_ROOT_PASSWORD=miniopassword
MINIO_SECURE=false
MINIO_BUCKET_NAME=documents

# JWT Security
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Keys (Loaded by Provider Manager)
GITHUB_TOKEN=your-github-models-token-here
GEMINI_API_KEY=your-gemini-api-key-here
